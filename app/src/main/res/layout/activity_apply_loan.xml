<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/secondary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="GET FINANCED"
            app:titleCentered="true"
            app:titleTextColor="@color/primary"
            app:titleTextAppearance="@style/Carmoola.TitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Track Application"
                android:textAppearance="@style/Carmoola.HeadlineLarge"
                android:textSize="28sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvMonthlyEstimate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated: $0.00 /mo"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/secondary"
                android:background="@color/primary"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/secondary"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Vehicle Name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="16dp"
                        app:boxStrokeColor="@color/secondary"
                        app:hintTextColor="@color/secondary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVehicleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Vehicle Price ($)"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="16dp"
                        app:boxStrokeColor="@color/secondary"
                        app:hintTextColor="@color/secondary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVehiclePrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/secondary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Down Payment ($)"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="16dp"
                        app:boxStrokeColor="@color/secondary"
                        app:hintTextColor="@color/secondary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDownPayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/secondary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Loan Amount Required"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/primaryContainer"
                        app:boxStrokeColor="@color/secondary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLoanAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="20sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadDoc"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="VERIFY IDENTITY"
                style="@style/Widget.Material3.Button.TonalButton"
                android:textColor="@color/secondary"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_upload_file_24"
                app:iconTint="@color/secondary"/>

            <TextView
                android:id="@+id/tvFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instant verification via Open Banking"
                android:textAlignment="center"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitLoan"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="48dp"
                android:text="GET INSTANT DECISION"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="32dp"
                android:backgroundTint="@color/secondary"
                android:textColor="@color/primary"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
